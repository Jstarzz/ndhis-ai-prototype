BIND_HOST=127.0.0.1
DEMO_API_KEY=ndhis-local-demo
WESTMERE_MODEL_ROOT=/srv/ndhis-ai-models
AGENT_MODEL_NAME=ndhis-agent-westmere
AGENT_MODEL_LABEL="Qwen3.5-4B Q4_K_M"
AGENT_MODEL_FILE=Qwen3.5-4B-Q4_K_M.gguf
AGENT_MAX_MODEL_LEN=4096
AGENT_MAX_TOKENS=128
AGENT_ROUTER_MAX_TOKENS=40
AGENT_ASSISTANT_MAX_TOKENS=96
WESTMERE_AGENT_PARALLEL=1
# Decode: start with one X5650 socket worth of physical cores.
WESTMERE_AGENT_THREADS=6
# Prompt/prefill: benchmark all 12 physical cores because BLAS can scale differently.
WESTMERE_AGENT_BATCH_THREADS=12
WESTMERE_AGENT_BATCH_SIZE=2048
WESTMERE_AGENT_UBATCH_SIZE=512
WESTMERE_AGENT_NUMA=distribute
WESTMERE_OMP_PROC_BIND=spread
# Keep none as the safe default. Benchmark ngram-simple and ngram-cache before enabling them on the target host.
WESTMERE_AGENT_SPEC_TYPE=none
ASR_MODEL_NAME=faster-whisper-base
TRANSLATION_MODEL_NAME=translatepsy-euronano-tiny
FORECAST_MODEL_NAME=autoregressive-ridge
# 2020-2026 hourly synthetic history can be used for long-range/backtest scenarios.
FORECAST_HISTORY_DAYS=2557
FORECAST_RIDGE_ALPHA=10
FORECAST_MAX_POINTS=2000
RADIOLOGY_MODEL_NAME=lung-cxr-densenet-pipeline-v1
RADIOLOGY_MODEL_REPO=a1mohamadd/lung-disease-detection
RADIOLOGY_MODEL_REVISION=884a901
RADIOLOGY_PIPELINE_SIZE=256
RADIOLOGY_SEGMENTATION_FILE=lung-segmentation.onnx
RADIOLOGY_SCREENING_FILE=healthy-unhealthy-densenet.onnx
RADIOLOGY_DISEASE_FILE=disease-densenet.onnx
RADIOLOGY_SEGMENTATION_THRESHOLD=0.5
RADIOLOGY_SCREENING_THRESHOLD=0.91
RADIOLOGY_OPENCV_THREADS=6
RADIOLOGY_MAX_UPLOAD_MB=32
RADIOLOGY_MAX_RESULTS=100
QVAC_TRANSLATION_VARIANT=Tiny
TRANSLATION_CHUNK_SECONDS=2.0
MAX_TRANSLATION_SESSION_SECONDS=3600
REQUESTS_PER_MINUTE=30
MAX_CONCURRENT_REQUESTS=2
MAX_BODY_MB=40
VITE_API_BASE=http://localhost:8080
VITE_DEMO_API_KEY=ndhis-local-demo
# Browser microphone access requires HTTPS (or localhost). An HTTPS deployment
# must use wss:// here to avoid mixed-content blocking.
VITE_TRANSLATION_WS=ws://localhost:8101/ws/translate
